@model CategoryResponseDto
@{
    ViewData["Title"] = "Edit Category";
}

<h2>Edit Category</h2>

<form id="editCategoryForm" action="@Url.Action("EditCategory", "Category")" method="post">
    @Html.HiddenFor(model => model.TermId)
    @Html.AntiForgeryToken()

    <div class="mb-3">
        @Html.LabelFor(model => model.Name, new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Name, new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(model => model.Name)
        <small class="form-text text-muted">The name is how it appears on your site.</small>
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Slug, new { @class = "form-label" })
        @Html.TextBoxFor(model => model.Slug, new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(model => model.Slug)
        <small class="form-text text-muted">
            The "slug" is the URL-friendly version of the name. It is usually all lowercase and contains only letters, numbers, and hyphens.
        </small>
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Parent, "Parent Category", new { @class = "form-label" })
        <select id="Parent" name="Parent" class="form-control">
            <option value="0">None</option>
            @if (ViewBag.ParentCategories != null)
            {
                foreach (var category in ViewBag.ParentCategories)
                {
                    <option value="@category.TermId" selected="@(category.TermId == Model.Parent ? "selected" : null)">
                        @category.Name
                    </option>
                }
            }
        </select>
    </div>

    <div class="mb-3">
        @Html.LabelFor(model => model.Description, new { @class = "form-label" })
        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 3 })
        @Html.ValidationMessageFor(model => model.Description)
        <small class="form-text text-muted">
            The description is not prominent by default; however, some themes may show it.
        </small>
    </div>

    <button type="submit" class="btn btn-primary">Update Category</button>
</form>

<script>
    $(document).ready(function () {
        $("#editCategoryForm").submit(function (e) {
            e.preventDefault();
            var formData = $("#editCategoryForm").serialize();
            $.ajax({
                url: "/Category/EditCategory",
                type: "POST",
                data: formData,
                success: function (response) {
                    if (response.success) {
                        alert("Category updated successfully!");
                        window.location.href = "/Category"; // Redirect to category list
                },
                error: function () {
                    alert("Failed to update category. Please try again.");
                }
            });
        });
    });
</script>
