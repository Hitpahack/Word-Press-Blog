@model CategoryRequestDto
@{
	ViewData["Title"] = "Categories";
}

<div class="container-fluid mt-4">
	<h2>Tags</h2>

	<div class="row">
		<!-- Add New Tag Form -->
		<div class="col-md-4">
			<div class="card shadow-sm">
				<div class="card-header bg-primary text-white">
					<h5 class="mb-0">Add New Category</h5>
				</div>
				<div class="card-body">
					<form asp-action="AddCategory" method="post">
						<div class="mb-3">
							@Html.LabelFor(m => m.Name)
							@Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name here" })
							@Html.ValidationMessageFor(x => x.Name)
						</div>

						<div class="mb-3">
							@Html.LabelFor(m => m.Slug)
							@Html.TextBoxFor(m => m.Slug, new { @class = "form-control", placeholder = "Enter Slug here" })
							@Html.ValidationMessageFor(m => m.Slug)
						</div>
						<div class="mb-3">
							<label for="ParentCategory" class="form-label">Parent Category</label>
							<select id="Parent" name="Parent" class="form-control">
								<option value="0">None</option>
								@if (ViewBag.ParentCategories != null)
								{
									foreach (var category in ViewBag.ParentCategories)
									{
										<option value="@category.TermId">
											@category.Name
										</option>
									}
								}
							</select>	
						</div>

						<div class="mb-3">
							@Html.LabelFor(m => m.Description)
							@Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3", placeholder = "Enter Description here" })
							@Html.ValidationMessageFor(m => m.Description)
                        </div>

						<button type="submit" class="btn btn-primary">Add New Category</button>
					</form>
				</div>
			</div>
		</div>

		<!-- Tags List Table -->
		<div class="col-md-8">
			<div class="row">
				<div class="col-12">
					<div class="row">
						<div class="col-8">
							<div class="tablenav top">
								<div class="alignleft actions bulkactions">
									<label for="bulk-action-selector-top" class="screen-reader-text">
										Select bulk
										action
									</label>
									<select name="action" id="bulk-action-selector-top" style="width:150px">
										<option value="-1">Bulk actions</option>
										<option value="delete">Delete</option>
									</select>
									<input type="button" onclick="doaction(this)" name="bulk_action" id="doaction" class="theme-button" value="Apply" />
								</div>
							</div>
						</div>
						<div class="col-4">
							<p class="search-box">
								<label class="screen-reader-text" for="post-search-input">Search Category:</label>
								<input type="search" id="post-search-input" name="s" value="">
								<input type="button" id="search-submit" class="button" value="Search Category">
							</p>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-sm-12">
					<div class="card-box">
						<div class="">
							<table class="table table-centered m-0" id="category_list_datatable">
								<thead class="thead-light">
									<tr>
										<th class="manage-column column-cb check-column">
											<input id="" type="checkbox" />
										</th>
										<th class="sorted ">
											<span>Name</span>
											<span class="sorting-indicators">
												<span class="sorting-indicator asc" aria-hidden="true"></span>
												<span class="sorting-indicator desc" aria-hidden="true"></span>
											</span>
										</th>
										<th class="sorted">
											<span>Description</span>
											<span class="sorting-indicators">
												<span class="sorting-indicator asc" aria-hidden="true"></span>
												<span class="sorting-indicator desc" aria-hidden="true"></span>
											</span>
										</th>
										<th class="sorted">
											<span>Slug</span>
											<span class="sorting-indicators">
												<span class="sorting-indicator asc" aria-hidden="true"></span>
												<span class="sorting-indicator desc" aria-hidden="true"></span>
											</span>
										</th>
										<th class="sorted">
											<span>Count</span>
											<span class="sorting-indicators">
												<span class="sorting-indicator asc" aria-hidden="true"></span>
												<span class="sorting-indicator desc" aria-hidden="true"></span>
											</span>
										</th>
									</tr>
								</thead>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


@section Styles {
	<link href="~/lib_npm/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
}
@section Scripts {
	<script src="~/lib_npm/datatables.net/js/jquery.dataTables.min.js"></script>
	<script src="~/lib_npm/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>
	<script src="~/js/appFunctions.js"></script>
	<script>
		$(document).ready(function () {
			appFun.categories.dt_category_list_datatable("@Url.Action("GetCategoryData", "Category")");
		});
		function doaction(elm) {
			appFun.categories.bulkactions(elm, "@Url.Action("DeleteCategory", "Category")");
		}
		$(document).on("click", ".deleteCategory", function () {
			var categoryId = $(this).data("id");
			appFun.categories.delete_category("@Url.Action("DeleteCategory", "Category")", {CategoryIds: [categoryId]});
		});

	</script>
}
