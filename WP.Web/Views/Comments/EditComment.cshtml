@model WP.EDTOs.Comments.EditCommentDto

@{
    ViewBag.Title = "Edit Comment";
    ViewBag.SubTitle = "Edit the comment details below.";
}

<form action="@Url.Action("EditComment", "Comments")" method="post">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(s => s.CommentId)

    <div class="container">
        <!-- Left Section (Comment Details) -->
        <div class="left-section">
            <!-- Author Section -->
            <div class="section">
                <h2 class="section-title">Author</h2>
                <div class="form-group">
                    @Html.LabelFor(m => m.CommentAuthor, "Name", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.CommentAuthor, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.CommentAuthor)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.CommentAuthorEmail, "Email", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.CommentAuthorEmail, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.CommentAuthorEmail)
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.CommentAuthorUrl, "URL", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.CommentAuthorUrl, new { @class = "form-control" })
                    @Html.ValidationMessageFor(x => x.CommentAuthorUrl)

                </div>
            </div>

            <!-- Comment Content -->
            <div class="section">
                <h2 class="section-title">Comment</h2>
                <div class="form-group">
                    @Html.TextAreaFor(m => m.CommentContent, new { @class = "form-control", rows = 10 })
                    @Html.ValidationMessageFor(x => x.CommentContent)
                </div>
            </div>
        </div>

        <!-- Right Section (Save & Status) -->
        <div class="right-section">
            <div class="save-box">
                <h3 class="section-title">Save</h3>

                <p><strong>Status:</strong></p>
                <div class="radio-group">
                    <label>
                        @Html.RadioButtonFor(m => m.CommentApproved, "approved", new { @class = "form-radio" }) Approved
                    </label>
                    <label>
                        @Html.RadioButtonFor(m => m.CommentApproved, "unapproved", new { @class = "form-radio" }) Pending
                    </label>
                    <label>
                        @Html.RadioButtonFor(m => m.CommentApproved, "spammed", new { @class = "form-radio" }) Spam
                    </label>
                </div>

                <p>In response to: <a href="@Model.Post_Title">@Model.Post_Title</a></p>

                <div class="button-group">
                    <a href="javascript:void(0);" class="updatestatus" data-id="@Model.CommentId" data-status="trashed">Move to Trash</a>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Styles {
    <link href="~/assets/css/wp_form.css" rel="stylesheet" />
    <style>
        /* Container for two-column layout */
        .container {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            max-width: 100%;
            margin: auto;
        }

        .left-section {
            flex: 2;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .right-section {
            flex: 1;
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            height: fit-content;
        }

        .section {
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 10px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 10px;
        }

        .form-label {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .form-control {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
        }

        .radio-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .button-group {
            display: flex;
            justify-content: space-between;
            margin-top: 15px;
        }
    </style>
}

@section Scripts {
    <script src="~/js/appFunctions.js"></script>
    <script>
        $(document).ready(function () {
            $(".btn-danger").click(function (e) {
                if (!confirm("Are you sure you want to delete this comment?")) {
                    e.preventDefault();
                }
            });
        });
        $(document).on("click", ".updatestatus", function () {
            if (!confirm("Are you sure you want to delete this comment?")) {
                    e.preventDefault();
            }
            var commentId = $(this).data("id");
            var status = $(this).data("status");
            appFun.comments.update_status('@Url.Action("UpdateCommentStatus", "Comments")', {CommentIds: [commentId],Status: status})
        });
    </script>
}
