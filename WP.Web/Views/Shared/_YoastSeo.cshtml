@model WP.EDTOs.POST_DTO
<div class="box-container post-content w-100">
    <h2 class="handle">
        Yoast SEO
    </h2>

    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" id="seo-tab" data-bs-toggle="tab" data-bs-target="#seo" type="button" role="tab" aria-controls="seo" aria-selected="true">SEO</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#readability" type="button" role="tab" aria-controls="readability" aria-selected="false">Readability</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="schema-tab" data-bs-toggle="tab" data-bs-target="#schema" type="button" role="tab" aria-controls="schema" aria-selected="false">Schema</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="social-tab" data-bs-toggle="tab" data-bs-target="#social" type="button" role="tab" aria-controls="social" aria-selected="false">Social</button></li>
    </ul>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="seo" role="tabpanel" aria-labelledby="seo-tab">
            <div class="box-content p-3">
                <label class="mb-2">Focus Keyphrase</label>
                @Html.TextBoxFor(s => s.Seo.Keyphrase)
                @Html.ValidationMessageFor(x => x.Seo.Keyphrase)
                <label id="keyword_result"></label>
                <br />
                <button type="button" class="button mt-3" id="get_keyphrases">
                    Get Related Keyphrase
                </button>

            </div>
            <div class="search-appearance">
                <div class="accordion" id="accordionExample">
                    <div class="card">
                        <div class="card-header" id="headingOne">
                            <button class="btn btn-link w-100" type="button" data-toggle="collapse"
                                    data-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                Search Appearance
                                <i class="mdi mdi-chevron-up"></i>
                            </button>
                        </div>
                        <div id="collapseOne" class="collapse show" aria-labelledby="headingOne"
                             data-parent="#accordionExample">
                            <div class="card-body">
                                This is the first item's accordion body. It is shown by default, until the
                                collapse plugin adds the appropriate classes that we use to style each element.
                                These classes control the overall look and feel, as well as the showing and
                                hiding behavior.


                            </div>
                            <fieldset class="sc-dGQEGF bqzFyQ">
                                <legend class="sc-PBEJI emLNeE">Preview as:</legend>
                                <input type="radio" name="screen" class="" id="seomobile" value="mobile" checked="">
                                <label for="seomobile" class="">Mobile result</label>
                                <input type="radio" name="screen" class="" id="seodesktop" value="desktop">
                                <label for="seodesktop" class="">Desktop result</label>
                            </fieldset>
                            <div class="search-preview">
                                <div class="url">

                                    <img src="data:image/png;base64," alt="Favicon">
                                    <span>BenvenutoLimos</span>
                                    <span>www.benvenutolimos.com › blog</span>
                                </div>
                                <div class="title">BenvenutoLimos - Blog</div>
                                <div class="meta">@(DateTime.Now.ToString("MMM dd, yyyy")) - Please provide a meta description by editing the snippet below. If you don’t, Google will try to find a relevant part of your post to show in the search results.</div>
                            </div>
                            <div class="seobox">
                                @Html.LabelFor(m => m.Seo.Seo_Title)
                                @Html.TextBoxFor(m => m.Seo.Seo_Title, new { id = "seo_title", @class = "form-control", placeholder = "Enter title here" })
                                @Html.ValidationMessageFor(x => x.Seo.Seo_Title)
                            </div>
                            <div class="seobox">
                                @Html.LabelFor(m => m.Seo.Seo_Slug)
                                @Html.TextBoxFor(m => m.Seo.Seo_Slug, new { id = "seo_slug", @class = "form-control", placeholder = "Enter title here" })
                                @Html.ValidationMessageFor(x => x.Seo.Seo_Slug)
                            </div>
                            <div class="seobox">
                                @Html.LabelFor(m => m.Seo.Seo_Meta_description)
                                @Html.TextBoxFor(m => m.Seo.Seo_Meta_description, new { id = "seo_meta", @class = "form-control", placeholder = "Enter title here" })
                                @Html.ValidationMessageFor(x => x.Seo.Seo_Meta_description)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="readability" role="tabpanel" aria-labelledby="readability-tab">...</div>
        <div class="tab-pane fade" id="schema" role="tabpanel" aria-labelledby="schema-tab">...</div>
        <div class="tab-pane fade" id="social" role="tabpanel" aria-labelledby="social-tab">...</div>
    </div>

</div>

                               