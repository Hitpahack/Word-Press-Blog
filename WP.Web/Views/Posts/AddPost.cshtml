    <script>
        $("#Post_Content").on("yoastseo:processed", function (event, data) {
            $("#result").empty();
            $.each(data, function (word, count) {
                //$("#result").append("<li>" + word + ": " + count + "</li>");
                $("#result").append("<li>" + word + "</li>");
            });
        });

        // Call the plugin on button click
        $("#get_keyphrases").click(function () {
            $("#Post_Content").yoastseo();
        });



        $uploadinpu = document.getElementById("featured_image_input");
        if ($uploadinpu) {
            document.getElementById("featured_image_input")
                .addEventListener("change", function (event) {
                    const file = event.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const imagePreview = document.getElementById("preview_image");
                            const imglbl = document.getElementById("imagelbltext");
                            imagePreview.src = e.target.result;
                            imagePreview.style.display = "block";
                            imglbl.innerText = "Change Featured Image "
                        };
                        reader.readAsDataURL(file);
                    }
                });
        }


        $('#remove_featured_image').click((d) => {
            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post("@Url.Action("RemoveFeaturedImage", "posts", new { postid = Model.Id })", function (response) {
                        if (response.data) {
                            Swal.fire({
                                title: "Deleted!",
                                text: "Your file has been deleted.",
                                icon: "success"
                            });
                        }
                        else {
                            console.error(response.message);
                        }
                    }).fail(function (xhr, status, error) {
                        alert("Error: " + xhr.responseText);
                    });

                }
            });


        })
    </script>



