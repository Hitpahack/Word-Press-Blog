@model WP.EDTOs.POST_DTO
@{

    ViewBag.Title = "Add New Post";
    ViewBag.SubTitle = "Create a brand new post and add them to this site.";
}

<!--content-->
<form action="@Url.Action("AddPost", null, new {post=ViewBag.Id})" class="new-post-form wp_form" method="post" enctype="multipart/form-data">
    <div class="" id="poststuff">
        <div class="" id="post-body-content">
            <div class="box-container post-content">


                @Html.AntiForgeryToken()
                @Html.HiddenFor(s => s.Id)
                @Html.HiddenFor(s => s.Seo.ReadabilityScore)
                @Html.HiddenFor(s => s.Seo.SeoScore)
                <div class="row">
                    <div class="col-6">
                        @Html.LabelFor(m => m.Post_Title)
                        @Html.TextBoxFor(m => m.Post_Title, new { @class = "form-control", placeholder = "Enter title here" })
                        @Html.ValidationMessageFor(x => x.Post_Title)
                    </div>

                    <div class="col-6">
                        @Html.LabelFor(m => m.Post_Name)
                        @Html.TextBoxFor(m => m.Post_Name, new { @class = "form-control", placeholder = "Enter name here" })
                        @Html.ValidationMessageFor(x => x.Post_Name)
                    </div>
                </div>

                <div id="wp-content-editor-tools" class="wp-editor-tools hide-if-no-js">
                    <div id="wp-content-media-buttons" class="wp-media-buttons">
                        <button type="button" id="insert-media-button" class="button insert-media add_media"
                                data-editor="content">
                            <span class="wp-media-buttons-icon"></span>
                            Add Media
                        </button>
                    </div>
                    <div class="wp-editor-tabs">
                        <button type="button" id="content-tmce" aria-pressed="true"
                                class="wp-switch-editor switch-tmce" data-wp-editor-id="content">
                            Visual
                        </button>
                        <button type="button" id="content-html" class="wp-switch-editor switch-html"
                                data-wp-editor-id="content">
                            Text
                        </button>
                    </div>
                </div>
                @Html.TextAreaFor(m => m.Post_Content)
                @Html.ValidationMessageFor(x => x.Post_Content)


            </div>

            <div class="box-container post-content w-100">
                <h2 class="handle">
                    Yoast SEO
                </h2>

                <ul class="nav nav-tabs" id="myTab" role="tablist">
                    <li class="nav-item" role="presentation"><button class="nav-link active" id="seo-tab" data-bs-toggle="tab" data-bs-target="#seo" type="button" role="tab" aria-controls="seo" aria-selected="true">SEO</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#readability" type="button" role="tab" aria-controls="readability" aria-selected="false">Readability</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" id="schema-tab" data-bs-toggle="tab" data-bs-target="#schema" type="button" role="tab" aria-controls="schema" aria-selected="false">Schema</button></li>
                    <li class="nav-item" role="presentation"><button class="nav-link" id="social-tab" data-bs-toggle="tab" data-bs-target="#social" type="button" role="tab" aria-controls="social" aria-selected="false">Social</button></li>
                </ul>
                <div class="tab-content" id="myTabContent">
                    <div class="tab-pane fade show active" id="seo" role="tabpanel" aria-labelledby="seo-tab">
                        <div class="box-content p-3">
                            <label class="mb-2">Focus Keyphrase</label>
                            @Html.TextBoxFor(s => s.Seo.Keyphrase)
                            @Html.ValidationMessageFor(x => x.Seo.Keyphrase)
                            <label id="keyword_result"></label>
                            <br />
                            <button type="button" class="button mt-3" id="get_keyphrases">
                                Get Related Keyphrase
                            </button>

                        </div>
                        <div class="search-appearance">
                            <div class="accordion" id="accordionExample">
                                <div class="card">
                                    <div class="card-header" id="headingOne">
                                        <button class="btn btn-link w-100" type="button" data-toggle="collapse"
                                                data-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                            Search Appearance
                                            <i class="mdi mdi-chevron-up"></i>
                                        </button>
                                    </div>
                                    <div id="collapseOne" class="collapse show" aria-labelledby="headingOne"
                                         data-parent="#accordionExample">
                                        <div class="card-body">
                                            This is the first item's accordion body. It is shown by default, until the
                                            collapse plugin adds the appropriate classes that we use to style each element.
                                            These classes control the overall look and feel, as well as the showing and
                                            hiding behavior.


                                        </div>
                                        <fieldset class="sc-dGQEGF bqzFyQ">
                                   <legend class="sc-PBEJI emLNeE">Preview as:</legend>
                                   <input type="radio" name="screen" class="" id="seomobile" value="mobile" checked="">
                                            <label for="seomobile" class="">Mobile result</label>
                                            <input type="radio" name="screen" class="" id="seodesktop" value="desktop">
                                            <label for="seodesktop" class="">Desktop result</label>
                                        </fieldset>
                                        <div class="search-preview">
                                            <div class="url">
                                                
                                                <img src="data:image/png;base64," alt="Favicon">
                                                <span>BenvenutoLimos</span>
                                                <span>www.benvenutolimos.com › blog</span>
                                            </div>
                                            <div class="title">BenvenutoLimos - Blog</div>
                                            <div class="meta">@(DateTime.Now.ToString("MMM dd, yyyy")) - Please provide a meta description by editing the snippet below. If you don’t, Google will try to find a relevant part of your post to show in the search results.</div>
                                        </div>
                                       <div class="seobox">
                                            @Html.LabelFor(m => m.Seo.Seo_Title)
                                            @Html.TextBoxFor(m => m.Seo.Seo_Title, new { id="seo_title", @class = "form-control", placeholder = "Enter title here" })
                                            @Html.ValidationMessageFor(x => x.Seo.Seo_Title)
                                        </div>  
                                        <div class="seobox">
                                            @Html.LabelFor(m => m.Seo.Seo_Slug)
                                            @Html.TextBoxFor(m => m.Seo.Seo_Slug, new { id = "seo_slug",  @class = "form-control", placeholder = "Enter title here" })
                                            @Html.ValidationMessageFor(x => x.Seo.Seo_Slug)
                                        </div>
                                        <div class="seobox">
                                            @Html.LabelFor(m => m.Seo.Seo_Meta_description)
                                            @Html.TextBoxFor(m => m.Seo.Seo_Meta_description, new { id = "seo_meta", @class = "form-control", placeholder = "Enter title here" })
                                            @Html.ValidationMessageFor(x => x.Seo.Seo_Meta_description)
                                        </div>
                                    </div>
                                   
                                    <div class="card-header" id="headingTwo">
                                        <button class="btn btn-link w-100" type="button" data-toggle="collapse" data-target="#collapseTwo" id="seoanalysis_control" aria-expanded="false" aria-controls="collapseTwo">
                                           SEO Analysis
                                            <i class="mdi mdi-chevron-up"></i>
                                        </button>
                                    </div>
                                    <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo"
                                         data-parent="#accordionExample">
                                        <div class="card-body" id="seoanalysis_content">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="readability" role="tabpanel" aria-labelledby="readability-tab">...</div>
                    <div class="tab-pane fade" id="schema" role="tabpanel" aria-labelledby="schema-tab">
                        <label>
                            What type of page or content is this?
                        </label>
                        @Html.LabelFor(m=>m.Seo.Seo_Page_Type)
                        @Html.DropDownListFor(model => model.Seo.Seo_Page_Type, (IEnumerable<SelectListItem>)ViewBag.PageTypes, new { @class = "form-control" })
                        @Html.ValidationMessageFor(s=>s.Seo.Seo_Page_Type)

                        @Html.LabelFor(m => m.Seo.Seo_Article_Type)
                        @Html.DropDownListFor(model => model.Seo.Seo_Article_Type, (IEnumerable<SelectListItem>)ViewBag.ArticleTypes, new { @class = "form-control" })
                        @Html.ValidationMessageFor(s => s.Seo.Seo_Article_Type)
                    </div>
                    <div class="tab-pane fade" id="social" role="tabpanel" aria-labelledby="social-tab">...</div>
                </div>

            </div>
        </div>
        <div class="postbox-container" id="container-right">
            <div class="post-rightbar">
                <div class="postbox">
                    <h2 class="handle">
                        Publish
                    </h2>
                    <div class="box-content">

                        <div class="plr-10 pt-10">
                            <a href="#" class="btn right">Preview</a>
                            <a href="Javascript:void(0);" id="save_draft_btn" class="btn">Save Draft</a>
                        </div>

                        <div class="misc-pub-section misc-pub-post-status">
                            <span class="mdi mdi-pin mdi-icon"></span>Status:
                            <span id="post-status-display">Draft</span>
                            <a href="#post_status" class="edit-post-status hide-if-no-js" role="button"
                               id="edit-post-status">
                                <span aria-hidden="true">Edit</span>
                                <span class="screen-reader-text">Edit status</span>
                            </a>

                            <div id="post-status-select" class="hide-if-js">
                                <input type="hidden" name="hidden_post_status" id="hidden_post_status"
                                       value="draft" />
                                <label for="post_status" class="screen-reader-text"> Set status </label>
                                <select name="post_status" id="post_status">
                                    <option value="pending">Pending Review</option>
                                    <option selected="selected" value="draft">Draft</option>
                                </select>
                                <a href="#post_status" class="save-post-status hide-if-no-js button">OK</a>
                                <a href="#post_status" class="cancel-post-status hide-if-no-js button-cancel"
                                   id="cancel-post-status">Cancel</a>
                            </div>
                        </div>

                        <div class="misc-pub-section misc-pub-visibility" id="visibility">
                            <span class="mdi mdi-eye-off mdi-icon"></span>Visibility:
                            <span id="post-visibility-display">
                                Public
                            </span>

                            <a href="#visibility" class="edit-visibility hide-if-no-js" role="button"
                               id="edit-visibility">
                                <span aria-hidden="true">Edit</span>
                                <span class="screen-reader-text">Edit visibility</span>
                            </a>

                            <div id="post-visibility-select" class="hide-if-js">
                                <input type="hidden" name="hidden_post_password" id="hidden-post-password"
                                       value="">
                                <input type="checkbox" style="display:none" name="hidden_post_sticky"
                                       id="hidden-post-sticky" value="sticky">

                                <input type="hidden" name="hidden_post_visibility" id="hidden-post-visibility"
                                       value="public">
                                <input type="radio" name="visibility" id="visibility-radio-public"
                                       value="public" checked="checked">
                                <label for="visibility-radio-public" class="selectit">Public</label><br>

                                <span id="sticky-span">
                                    <input id="sticky" name="sticky" type="checkbox" value="sticky">
                                    <label for="sticky" class="selectit">
                                        Stick this post to the front
                                        page
                                    </label><br>
                                </span>

                                <input type="radio" name="visibility" id="visibility-radio-password"
                                       value="password">
                                <label for="visibility-radio-password" class="selectit">
                                    Password
                                    protected
                                </label><br>

                                <span id="password-span" style="display: none;">
                                    <label for="post_password">Password:</label>
                                    <input type="text" name="post_password" id="post_password" value=""
                                           maxlength="255"><br>
                                </span>

                                <input type="radio" name="visibility" id="visibility-radio-private"
                                       value="private">
                                <label for="visibility-radio-private" class="selectit">Private</label><br>

                                <p>
                                    <a href="#visibility"
                                       class="save-post-visibility hide-if-no-js button">OK</a>
                                    <a href="#visibility"
                                       class="cancel-post-visibility hide-if-no-js button-cancel"
                                       id="cancel-post-visibility">Cancel</a>
                                </p>
                            </div>
                        </div>

                        <div class="misc-pub-section misc-pub-publishDate" id="publishDate">
                            <span class="mdi mdi-eye-off mdi-icon"></span>Publish on:
                            <span id="post-publishDate-display">
                                Sep 24, 2024 at 13:45
                            </span>

                            <a href="#publishDate" class="edit-publishDate hide-if-no-js" role="button"
                               id="edit-publishDate">
                                <span aria-hidden="true">Edit</span>
                                <span class="screen-reader-text">Edit publishDate</span>
                            </a>

                            <div id="post-publishDate-select" class="hide-if-js">
                                <input type="date" id="publishDate-picker">
                                <a href="#publishDate" class="save-publishDate hide-if-no-js button">OK</a>
                                <a href="#publishDate" class="cancel-publishDate hide-if-no-js button-cancel"
                                   id="cancel-publishDate">Cancel</a>
                            </div>

                           
                        </div>
                        <div class="misc-pub-section misc-pub-publishDate">
                            <a href="javascript:void(0);" id="gotoseotab"><b>SEO analysis</b></a>: <span id="seo_score_box">Not available</span>
                            
                        </div>
                        <div class="misc-pub-section misc-pub-publishDate">

                            <a href="javascript:void(0);" id="gotoreadabilitytab"><b> Readability analysis</b></a>: <span id="readability_score_box">Not available</span>
                        </div>

                        <div class="publish-content">
                            <button type="submit" class="button">Publish</button>
                            <a href="#" class="move-trash">Move to trash</a>
                        </div>
                    </div>
                </div>
                <div class="postbox">
                    <h2 class="handle">
                        Categories
                    </h2>
                    <div class="box-content">
                        <div class="category-container">
                            <ul>
                                @foreach (var category in Model.CategoriesItems)
                                {
                                    @(Html.Partial("_Categories", category))

                                }
                            </ul>
                        </div>
                        <div class="add-new-cat">
                            <a href="#" id="toggle-cat-collapse" onclick="addnewcategory(this)" role="button">
                                <i class="fa fa-plus"></i> Add New Category
                            </a>

                        </div>
                    </div>
                </div>

                <div class="postbox">
                    <h2 class="handle">
                        Tags
                    </h2>
                    <div class="box-content">
                        <div class="category-container">
                            <ul id="tags_dropdowns">
                                @foreach (var category in Model.TagsItem)
                                {
                                    @(Html.Partial("_Tags", category))

                                }
                            </ul>
                        </div>
                        <div class="add-new-cat">
                            <a href="#" id="toggle-cat-collapse" onclick="addnewtag(this)" role="button">
                                <i class="fa fa-plus"></i> Add Tag
                            </a>

                        </div>
                    </div>
                    <div>
                        <div class="tag-container" id="tag-box">
                            <input id="tag-input" class="tag-input" type="text" placeholder="Type a tag..." />
                        </div>
                    </div>
                </div>

                <div class="postbox">
                    <h2 class="handle">
                        Featured Image
                    </h2>

                    @if (!string.IsNullOrEmpty(Model.featured_image_url))
                    {
                        <img src="@Model.featured_image_url" class="feat_image" id="preview_image" />
                        <div class="add-new-cat">
                            <a href="javascript:void(0);" id="remove_featured_image" role="button">
                                <i class="fa fa-image"></i>  <span id="imagelbltext">Remove featured image</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <img class="feat_image" id="preview_image" />
                        <div class="add-new-cat">
                            <a href="javascript:void(0);" id="lbl_featured_image" role="button">
                                @Html.TextBoxFor(s => s.FeaturedImage, new { id = "featured_image_input", Type = "file" })
                                <i class="fa fa-image"></i>  <span id="imagelbltext">Set Featured Image</span>
                            </a>
                        </div>
                    }



                </div>

            </div>
        </div>


        <!-- <div class="box-container post-content">
            <div class="box">
                <h2 class="handle">
                    Test Block
                </h2>
                <div class="box-content">
                    This is a test block for add new post
                </div>
            </div>
        </div> -->
    </div>


</form>


@section Styles {
    <link href="~/assets/css/wp_form.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
.search-preview {
            width: 90%;
            max-width: 600px;
            background: #fff;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        .search-preview .url {
            font-size: 14px;
            color: #4d5156;
            margin-bottom: 3px;
            display: flex;
            align-items: center;
        }
        .search-preview .url img {
            width: 16px;
            height: 16px;
            margin-right: 5px;
        }
        .search-preview .title {
            font-size: 18px;
            color: #1a0dab;
            font-weight: bold;
            margin-bottom: 3px;
            cursor: pointer;
        }
        .search-preview .title:hover {
            text-decoration: underline;
        }
        .search-preview .meta {
            font-size: 14px;
            color: #4d5156;
        }
        /* Mobile Styling */
        @@media (max-width: 600px) {
            .search-preview {
                max-width: 100%;
                padding: 10px;
            }
            .search-preview .title {
                font-size: 16px;
            }
            .search-preview .meta {
                font-size: 12px;
            }
        }</style>
}

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.ckeditor.com/ckeditor5/41.3.1/classic/ckeditor.js"></script>
    <script src="~/js/yoastseo.js"></script>
    <script>
        let editorInstance;
        let yoastseo;
        function addnewcategory() {

            Swal.fire({
                title: "Add new Category",
                html: `
                                                             <div class="add_category">
                                                             <form action="@Url.Action("AddCategory")" method="post">
        @Html.TextBoxFor(m => m.NewCategory,
                                                                       new
                                                                       {
                                                                           @class = "form-control",
                                                                           placeholder = "Enter category here"
                                                                       })
        @Html.ValidationMessageFor(x => x.NewCategory)


                                                                                        <select id="@Html.DisplayNameFor(s => s.ParentCatId)" name="@Html.DisplayNameFor(s => s.ParentCatId)">
                                                                                    <option value="">-- Select Category --</option>
        @foreach (var category in Model.CategoriesItems.Concat(Model.CategoriesItems.SelectMany(s => s.Subcategory)))
        {
                                                                        <option  value="@category.Term_Id">@category.Name</option>
            // <optgroup label="@category.Name">
            //     @foreach (var subcategory in category.Subcategory)
            //     {
            //         <option  value="@subcategory.Term_Id">@subcategory.Name</option>
            //     }
            // </optgroup>
        }
                                                                                </select>

                                                                                <button type="Submit">Add New Category</button>

                                                                            </div>
                                                  `,
                showCloseButton: true,
                focusConfirm: false,
                confirmButtonText: `Save`,
                cancelButtonText: `Cancel`,
                preConfirm: () => {
                    const categoryName = $('#NewCategory').val();
                    const categoryId = $('#ParentCatId').val();
                    if (!categoryName) {
                        Swal.showValidationMessage("please enter rquired field!");
                    }
                    return { categoryId, categoryName };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("AddCategory")",
                        data: {
                            catid: result.value.categoryId,
                            cat: result.value.categoryName
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire("Success!", response.message, "success");
                            } else {
                                Swal.fire("Error!", response.message, "error");
                            }
                        },
                        error: function () {
                            Swal.fire("Error!", "Something went wrong.", "error");
                        }
                    });
                }
            });


        }
        document.addEventListener("DOMContentLoaded", function () {
            // Initialize CKEditor only if the element exists
            const editorElement = document.querySelector("#Post_Content");
            if (editorElement) {
                ClassicEditor.create(editorElement, {
                    toolbar: [
                        'heading', '|', 'bold', 'italic', 'underline', 'strikethrough', 'code', '|', 
                        'link', 'bulletedList', 'numberedList', 'blockQuote', 'insertTable', 'tableColumn', 'tableRow', 'mergeTableCells', '|',
                        'undo', 'redo', 'alignment', 'fontSize', 'fontFamily', 'fontColor', 'highlight', 'subscript', 'superscript', 'code', '|',
                        'imageUpload', 'mediaEmbed', 'blockQuote', 'insertTable', 'link', '|', 'sourceEditing', 'codeBlock', 'htmlEmbed', 'horizontalLine',
                        'specialCharacters', 'emoji', 'pageBreak', 'findAndReplace'
                    ],
                    image: {
                        toolbar: ['imageTextAlternative', 'imageStyle:full', 'imageStyle:side']
                    },
                    ckfinder: {
                        uploadUrl: '/your-upload-endpoint' // Replace with your actual upload URL
                    },
                    language: 'en',
                    height: 400,
                    removePlugins: ['image', 'mediaEmbed', 'table', 'codeBlock']
                })
                    .then(editor => {
                        editorInstance = editor;
                        yoastseo = yoastSEO({
                            contentSelector: '#Post_Content',
                            editor: editorInstance,
                            seo: {
                                focusKeyphrase: $('#Seo_Keyphrase'),
                                seoTitle: $('#seo_title'),
                                slug: $('#seo_slug'),
                                metaDescription: $('#seo_meta')
                            }
                        });
                        yoastseo.generate_Seo_Score((result) => {
                            $('#readability_score_box,#gotoreadabilitytab').removeAttr('class');
                            $('#readability_score_box').text('Not analyzed');
                            $('#Seo_ReadabilityScore').val('');
                            $('#gotoseotab,#seo_score_box').removeAttr('class');
                            $('#seo_score_box').text('Not analyzed');
                            $('#Seo_SeoScore').val('');

                            if (result.readability_rate) {
                                $('#readability_score_box,#gotoreadabilitytab').removeClass();
                                $('#readability_score_box,#gotoreadabilitytab').addClass(result.readability_rate);

                                $('#readability_score_box').text(result.readability_rate);
                                $('#Seo_ReadabilityScore').val(result.readability_rate.toLowerCase().replace(" ", "_"));
                            }

                            if (result.seo_rate) {
                                $('#gotoseotab,#seo_score_box').addClass(result.seo_rate);
                                $('#seo_score_box').text(result.seo_rate);
                                $('#Seo_SeoScore').val(result.seo_rate.toLowerCase().replace(" ", "_"));
                            }
                            console.log(result)
                        });
                        console.log("CKEditor initialized successfully.");
                    })
                    .catch(error => {
                        console.error("Error initializing CKEditor:", error);
                    });
            } else {
                console.warn("Editor element (#editor) not found. CKEditor initialization skipped.");
            }

            // Generic function to toggle visibility of elements
            function toggleVisibility(triggerSelector, targetSelector, action) {
                document.querySelector(triggerSelector)?.addEventListener("click", function (event) {
                    event.preventDefault();
                    const targetElement = document.querySelector(targetSelector);
                    if (targetElement) {
                        if (action === "show") {
                            targetElement.classList.remove("hide-if-js");
                        } else if (action === "hide") {
                            targetElement.classList.add("hide-if-js");
                        }
                    }
                });
            }

            // Apply visibility toggles
            toggleVisibility("#edit-post-status", "#post-status-select", "show");
            toggleVisibility("#cancel-post-status", "#post-status-select", "hide");

            toggleVisibility("#edit-visibility", "#post-visibility-select", "show");
            toggleVisibility("#cancel-post-visibility", "#post-visibility-select", "hide");

            toggleVisibility("#edit-publishDate", "#post-publishDate-select", "show");
            toggleVisibility("#cancel-publishDate", "#post-publishDate-select", "hide");
        });
        function addnewtag() {

            Swal.fire({
                title: "Add new Tag",
                html: `
                                                                     <div class="add_category">
                     
                      <input type="text" id="tag_name" name="name" value="" placeholder="enter tag name"/>
                     <input type="text" id="tag_description" name="description" value="" placeholder="enter tag description"/>
                       <button type="button">Add New Tag</button>
                       </div>
                                                          `,
                showCloseButton: true,
                focusConfirm: false,
                confirmButtonText: `Save`,
                cancelButtonText: `Cancel`,
                preConfirm: () => {
                    const tagName = $('#tag_name').val();
                    const tag_description = $('#tag_description').val();
                    if (!tagName || !tag_description) {
                        Swal.showValidationMessage("please enter tag and description field!");
                    }
                    return { tagName, tag_description };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("AddTag", "Tag")",
                        data: {
                            name: result.value.tagName,
                            description: result.value.tag_description,
                            asJson:true
                        },
                        success: function (response) {
                            if (response.success) {
                                console.log(response);
                                $(`<li>
                                    <label for="${response.data.termTaxonomyId}">
                                    <input type="checkbox" id="${response.data.termTaxonomyId}" name="tags[]" value="${response.data.termTaxonomyId}">
                                    ${response.data.name}</label>
                                </li>`).prependTo($('#tags_dropdowns'));
                                Swal.fire("Success!", response.message, "success");
                            } else {
                                Swal.fire("Error!", response.message, "error");
                            }
                        },
                        error: function () {
                            Swal.fire("Error!", "Something went wrong.", "error");
                        }
                    });
                }
            });


        }

    </script>
    <script>
        

        $('#seo_title').on('keyup', (e) => {
            if (e.currentTarget.value.length <= 0) {
                $('.search-preview .title').html('BenvenutoLimos - Blog')
            }
            else {
                $('.search-preview .title').html(e.currentTarget.value)
                
            }
        })
        $('#seo_meta').on('keyup', (e) => {
            
            if (e.currentTarget.value.length <= 0) {
                const date = new Date(2025, 2, 17); // Month is 0-based (2 = March)
                const formattedDate = date.toLocaleDateString("en-US", { day: '2-digit', month: 'short', year: 'numeric' });

                $('.search-preview .meta').html(`${formattedDate} - Please provide a meta description by editing the snippet below. If you don’t, Google will try to find a relevant part of your post to show in the search results.`)
            }
            else {
                $('.search-preview .meta').html(e.currentTarget.value)

            }
        })
        $("#get_keyphrases").click(function () {
            yoastseo.focusKeyword((result) => {
                $('#keyword_result').html(result)

            });
        });
        $("#seoanalysis_control").click(function () {
            yoastseo.getSeoAnylisis((result) => {
                console.log(result)
                const container = document.getElementById("seoanalysis_content");
                container.innerHTML = '';
                Object.keys(result).forEach(category => {
                    if (Object.keys(result[category]).length > 0) {
                        // Create category section
                        const section = document.createElement("div");
                        section.classList.add("category");
                        if (category === "Needs Improvement") section.classList.add("needs-improvement");
                        if (category === "Problems") section.classList.add("problems");

                        // Add heading
                        const heading = document.createElement("h2");
                        heading.textContent = category;
                        section.appendChild(heading);

                        // Create unordered list
                        const list = document.createElement("ul");
                        list.setAttribute('class', 'seo_readability');
                        Object.entries(result[category]).forEach(([key, value]) => {
                            const listItem = document.createElement("li");
                            listItem.innerHTML = `<a class="${category}" href="javascript:void(0);"><b>${key}:</b></a> ${value}`;
                            list.appendChild(listItem);
                        });

                        section.appendChild(list);
                        container.appendChild(section);
                    }
                });
            });
        });
        
        $("#profile-tab").click(function () {
            debugger;
            yoastseo.readability((result) => {
                // Group by resultflag
                console.log(result)
                let groupedData = {};
                result.forEach(item => {
                    if (!groupedData[item.resultflag]) {
                        groupedData[item.resultflag] = [];
                    }
                    groupedData[item.resultflag].push(item);
                });

                // Append to HTML
                let $container = $("#readability");
                $($container).html('');
                $.each(groupedData, function (group, items) {
                    let $groupList = $("<ul class='seo_readability'>").append(`<li><strong>${group}</strong></li>`);
                    items.forEach(item => {
                        $groupList.append(`<li><a class="${item.resultflag}" href="javascript:void(0);"><b>${item.title}:</b></a> ${item.result_message}</li>`);
                    });
                    $container.append($groupList);
                });


            });
        });


        $uploadinpu = document.getElementById("featured_image_input");
        if ($uploadinpu) {
            document.getElementById("featured_image_input")
                .addEventListener("change", function (event) {
                    const file = event.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const imagePreview = document.getElementById("preview_image");
                            const imglbl = document.getElementById("imagelbltext");
                            imagePreview.src = e.target.result;
                            imagePreview.style.display = "block";
                            imglbl.innerText = "Change Featured Image "
                        };
                        reader.readAsDataURL(file);
                    }
                });
        }


        $('#remove_featured_image').click((d) => {
            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post("@Url.Action("RemoveFeaturedImage", "posts", new { postid = Model.Id })", function (response) {
                        if (response.data) {
                            Swal.fire({
                                title: "Deleted!",
                                text: "Your file has been deleted.",
                                icon: "success"
                            });
                        }
                        else {
                            console.error(response.message);
                        }
                    }).fail(function (xhr, status, error) {
                        alert("Error: " + xhr.responseText);
                    });

                }
            });


        })
        $('#gotoseotab').on('click', () => {
            $('#seo-tab').trigger('click');
            window.location.href = '#seo';
            $('#seoanalysis_control').trigger('click');
        })
        $('#gotoreadabilitytab').on('click', () => {
            $('#profile-tab').trigger('click');
            window.location.href = '#readability';
        })

                                </script>
    <script>
        $(document).ready(function () {
            let selectedTags = [];

            $("#tag-input").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/Posts/GetTags",
                        type: "GET",
                        dataType: "json",
                        data: {
                            term: request.term,
                            selectedTags: selectedTags
                        },
                        success: function (data) {
                            response(data);
                        }
                    });
                },
                minLength: 2,
                select: function (event, ui) {
                    event.preventDefault();

                    if (!selectedTags.includes(ui.item.value)) {
                        selectedTags.push(ui.item.value);
                        updateTagList();
                    }

                    $("#tag-input").val(""); // Clear input after selection
                }
            });

            function updateTagList() {
                let tagContainer = $("#tag-box");
                tagContainer.find(".tag-item").remove(); // Clear old tags

                selectedTags.forEach(tag => {
                    tagContainer.prepend(`
                        <span class="tag-item">
                            ${tag} <span class="remove-tag" data-tag="${tag}">&times;</span>
                        </span>
                    `);
                });

                $(".remove-tag").on("click", function () {
                    let tagToRemove = $(this).data("tag");
                    selectedTags = selectedTags.filter(t => t !== tagToRemove);
                    updateTagList();
                });
            }
        });
    </script>
