    <script>

        function addnewcategory() {

            Swal.fire({
                title: "Add new Category",
                html: `
                                                     <div class="add_category">
                                                     <form action="@Url.Action("AddCategory")" method="post">
        @Html.TextBoxFor(m => m.NewCategory,
                                                              new
                                                              {
                                                                  @class = "form-control",
                                                                  placeholder = "Enter category here"
                                                              })
        @Html.ValidationMessageFor(x => x.NewCategory)


                                                                                <select id="@Html.DisplayNameFor(s => s.ParentCatId)" name="@Html.DisplayNameFor(s => s.ParentCatId)">
                                                                            <option value="">-- Select Category --</option>
        @foreach (var category in Model.CategoriesItems.Concat(Model.CategoriesItems.SelectMany(s => s.Subcategory)))
        {
                                                            <option  value="@category.Term_Taxonomy_Id">@category.Name</option>
            // <optgroup label="@category.Name">
            //     @foreach (var subcategory in category.Subcategory)
            //     {
            //         <option  value="@subcategory.Term_Taxonomy_Id">@subcategory.Name</option>
            //     }
            // </optgroup>
        }
                                                                        </select>

                                                                        <button type="Submit">Add New Category</button>

                                                                    </div>
                                          `,
                showCloseButton: true,
                focusConfirm: false,
                confirmButtonText: `Save`,
                cancelButtonText: `Cancel`,
                preConfirm: () => {
                    const categoryName = $('#NewCategory').val();
                    const categoryId = $('#ParentCatId').val();
                    if (!categoryName) {
                        Swal.showValidationMessage("please enter rquired field!");
                    }
                    return { categoryId, categoryName };
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        type: "POST",
                        url: "@Url.Action("AddCategory")",
                        data: {
                            catid: result.value.categoryId,
                            cat: result.value.categoryName
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire("Success!", response.message, "success");
                            } else {
                                Swal.fire("Error!", response.message, "error");
                            }
                        },
                        error: function () {
                            Swal.fire("Error!", "Something went wrong.", "error");
                        }
                    });
                }
            });


        }
